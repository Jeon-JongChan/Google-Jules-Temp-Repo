{
  "name": "lightweight-graph-mcp",
  "publisher": "graph-mcp-dev",
  "displayName": "Lightweight Graph MCP",
  "description": "Lightweight Code Graph MCP for VS Code",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "graph-mcp.buildIndex",
        "title": "Graph MCP: Build Index"
      },
      {
        "command": "graph-mcp.rebuildIndex",
        "title": "Graph MCP: Rebuild Index"
      },
      {
        "command": "graph-mcp.clearCache",
        "title": "Graph MCP: Clear Cache"
      },
      {
        "command": "graph-mcp.showStatus",
        "title": "Graph MCP: Show Status"
      },
      {
        "command": "graph-mcp.openLogs",
        "title": "Graph MCP: Open Logs"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "test": "jest",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.31.1",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.27.1"
  }
}
