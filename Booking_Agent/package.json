{
  "name": "booking_agent",
  "version": "1.0.0",
  "description": "A semi-automated booking agent for various ticket sites.",
  "main": "src/main/index.js",
  "scripts": {
    "postinstall": "npx playwright install chromium",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "test": "node tests/test_detect_site.js && node tests/test_seat_selection.js && node tests/test_automation_service.js && node tests/test_browser_facade.js"
  },
  "author": "Jules",
  "license": "ISC",
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "kr.co.bookingagent",
    "productName": "Booking Agent",
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "directories": {
      "output": "dist"
    }
  }
}
